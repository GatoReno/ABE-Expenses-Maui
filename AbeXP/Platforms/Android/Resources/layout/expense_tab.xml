<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
			xmlns:app="http://schemas.android.com/apk/res-auto"
			android:theme="@style/Theme.Light.NoActionBar" 
			android:layout_width="match_parent"
			android:layout_height="match_parent">

	<LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


		<!--Description-->
		<com.google.android.material.textfield.TextInputLayout
			android:id="@+id/lytExpenseDescription"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/txtExpenseDescription"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:inputType="text"/>
		</com.google.android.material.textfield.TextInputLayout>

		<!--Date-->
		<com.google.android.material.textfield.TextInputLayout
			android:id="@+id/lytExpenseDate"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/edtExpenseDate"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:focusable="false"
				android:clickable="true"
				android:inputType="text"/>
		</com.google.android.material.textfield.TextInputLayout>

		<!--Amount-->
		<com.google.android.material.textfield.TextInputLayout
			android:id="@+id/lytExpenseAmount"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/txtExpenseAmount"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:inputType="numberDecimal"/>
		</com.google.android.material.textfield.TextInputLayout>


		<!--Payment type-->
		<com.google.android.material.textfield.TextInputLayout
			android:id="@+id/lytPaymentType"
			style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
			android:layout_width="match_parent"
			android:layout_height="wrap_content">

			<com.google.android.material.textfield.MaterialAutoCompleteTextView
				android:id="@+id/ddlPaymentType"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"/>

		</com.google.android.material.textfield.TextInputLayout>

		<!--Tags-->
		<com.google.android.material.textfield.TextInputLayout
			android:id="@+id/lytTags"
			style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
			android:layout_width="match_parent"
			android:layout_height="wrap_content">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/edtTags"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:focusable="false"
				android:clickable="true" />
		</com.google.android.material.textfield.TextInputLayout>


		<!-- Save button -->
		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnSaveExpense"
			android:textColor="@android:color/white"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			style="@style/Widget.MaterialComponents.Button"
			android:layout_marginTop="16dp"/>

	</LinearLayout>
</ScrollView>
