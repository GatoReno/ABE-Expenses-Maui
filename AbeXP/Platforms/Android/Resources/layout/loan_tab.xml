<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
			android:layout_width="match_parent"
			xmlns:app="http://schemas.android.com/apk/res-auto"
			android:theme="@style/Theme.Light.NoActionBar" 
			android:layout_height="match_parent">

	<LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


		<!--Person name-->
		<com.google.android.material.textfield.TextInputLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
			android:hint="Person name">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/txtLoanPersonName"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:inputType="text"/>
		</com.google.android.material.textfield.TextInputLayout>


		<!--Email-->
		<com.google.android.material.textfield.TextInputLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
			android:hint="Email">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/txtLoanEmail"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:inputType="text"/>
		</com.google.android.material.textfield.TextInputLayout>


		<!--Amount-->
		<com.google.android.material.textfield.TextInputLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
			android:hint="Amount">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/txtLoanAmount"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:inputType="numberDecimal"/>
		</com.google.android.material.textfield.TextInputLayout>


		<!--Date given-->
		<com.google.android.material.textfield.TextInputLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
			android:hint="Date given">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/edtLoanDate"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:focusable="false"
				android:clickable="true"
				android:inputType="text"/>
		</com.google.android.material.textfield.TextInputLayout>


		<!--Payment date-->
		<com.google.android.material.textfield.TextInputLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
			android:hint="Payment date">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/edtPaymentDate"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:focusable="false"
				android:clickable="true"
				android:inputType="text"/>
		</com.google.android.material.textfield.TextInputLayout>

		
		<!--Is paid?-->
		<com.google.android.material.checkbox.MaterialCheckBox
			android:id="@+id/chkIsPaid"
			android:visibility="visible"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Is paid?" />
		
		
		<!--Notes-->
		<com.google.android.material.textfield.TextInputLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
			android:hint="Notes">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/txtLoanNotes"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:inputType="textMultiLine"
				android:minLines="3"
				android:gravity="top" />
		</com.google.android.material.textfield.TextInputLayout>
		
		
		<!-- Save button -->
		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnSaveLoan"
			 android:textColor="@android:color/white"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Save"
			style="@style/Widget.MaterialComponents.Button"
			android:layout_marginTop="16dp"/>

	</LinearLayout>
</ScrollView>
