<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AbeXP.Controls.ButtonWithContent"
             x:Name="this">

    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Grid BindingContext="{x:Reference this}" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    
                </Grid.RowDefinitions>

                <Button  
                        Command="{Binding Command}" 
                        CommandParameter="{Binding CommandParameter}" 
                        BackgroundColor="{Binding BackgroundColor}"
                        HeightRequest="{Binding Path=HeightRequest, Source={x:Reference this}}"
                        MinimumHeightRequest="{Binding Path=HeightRequest, Source={x:Reference this}}"
                        WidthRequest="{Binding WidthRequest, Source={x:Reference this}}"
                        VerticalOptions="Fill" 
                        HorizontalOptions="Fill"/>

                <ContentPresenter 
                                  InputTransparent="True"
                                  CascadeInputTransparent="False"
                                  HeightRequest="{Binding Path=HeightRequest, Source={x:Reference this}}"
                                  MinimumHeightRequest="{Binding Path=HeightRequest, Source={x:Reference this}}"
                                  WidthRequest="{Binding WidthRequest, Source={x:Reference this}}"
                                  VerticalOptions="Fill"
                                  HorizontalOptions="Fill"/>
                                  <!--VerticalOptions="{Binding VerticalOptions, Source={x:Reference this}}" 
                                  HorizontalOptions="{Binding HorizontalOptions, Source={x:Reference this}}"-->
            </Grid>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>
