<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="AbeXP.Views.LoginView"
    Title="Login">

    <Grid Padding="30" RowSpacing="15" VerticalOptions="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Ícono -->
            <RowDefinition Height="Auto"/> <!-- 1: Título -->
            <RowDefinition Height="Auto"/> <!-- 2: Email -->
            <RowDefinition Height="Auto"/> <!-- 3: Password -->
            <RowDefinition Height="Auto"/> <!-- 4: Confirm Password -->
            <RowDefinition Height="Auto"/> <!-- 5: Username -->
            <RowDefinition Height="Auto"/> <!-- 6: Botón principal -->
            <RowDefinition Height="Auto"/> <!-- 7: Switch de modo -->
            <RowDefinition Height="Auto"/> <!-- 8: ActivityIndicator -->
            <RowDefinition Height="Auto"/> <!-- 9: Error Message -->
            <RowDefinition Height="Auto"/> <!-- 10: Recuperar contraseña -->
        </Grid.RowDefinitions>

        <!-- Ícono de la app -->
        
        <Image
            Source="abelogo.png"
            HeightRequest="120"
            WidthRequest="120"
            Grid.Row="0"
            HorizontalOptions="Center"
            VerticalOptions="Center"/>

        <!-- Título dinámico -->
        <Label 
            Grid.Row="1" 
            Text="{Binding TitleText}" 
            FontSize="24" 
            HorizontalOptions="Center" 
            Margin="0,10,0,0"/>

        <!-- Email -->
        <Entry 
            Grid.Row="2" 
            Placeholder="Email" 
            Keyboard="Email" 
            Text="{Binding Email, Mode=TwoWay}" />

        <!-- Password -->
        <Entry 
            Grid.Row="3" 
            Placeholder="Password" 
            IsPassword="True" 
            Text="{Binding Password, Mode=TwoWay}" />

        <!-- Confirm Password (solo SignUp) -->
        <Entry 
            Grid.Row="4" 
            Placeholder="Confirmar Password" 
            IsPassword="True" 
            Text="{Binding ConfirmPassword, Mode=TwoWay}" 
            IsVisible="{Binding IsSignUpMode}" />

        <!-- Botón principal -->
        <Button 
            Grid.Row="6" 
            Text="{Binding PrimaryButtonText}" 
            Command="{Binding ExecutePrimaryActionCommand}" 
            IsEnabled="{Binding IsNotBusy}" />

        <!-- Switch de modo -->
        <Button 
            Grid.Row="7" 
            Text="{Binding SwitchButtonText}" 
            Command="{Binding SwitchModeCommand}" />

        <!-- ActivityIndicator -->
        <ActivityIndicator 
            Grid.Row="8" 
            IsRunning="{Binding IsBusy}" 
            IsVisible="{Binding IsBusy}" 
            HorizontalOptions="Center" />

        <!-- Mensaje de error -->
        <Label 
            Grid.Row="9" 
            Text="{Binding ErrorMessage}" 
            TextColor="Red" 
            FontSize="12" 
            HorizontalOptions="Center" />

        <!-- Botón recuperar contraseña (solo Login) -->
        <Button 
            Grid.Row="10" 
            Text="¿Olvidaste tu contraseña?" 
            Command="{Binding RecoverPasswordCommand}" 
            IsVisible="{Binding IsLoginMode}" 
            HorizontalOptions="Center" 
            FontAttributes="Italic" 
            BackgroundColor="Transparent" 
            TextColor="Blue" />
    </Grid>
</ContentPage>
