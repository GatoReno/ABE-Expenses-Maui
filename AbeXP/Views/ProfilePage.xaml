<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:AbeXP.Resources.Strings"
             x:Class="AbeXP.Views.ProfilePage"
             Title="Profile 💸">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
    

            <Frame Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static resources:AppResources.Email}" FontAttributes="Bold" />
                    <Label Text="{Binding Email}" FontSize="18" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
